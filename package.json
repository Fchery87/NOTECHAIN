{
  "name": "notechain",
  "version": "0.0.1",
  "private": true,
  "description": "Privacy-first, web-based productivity suite with end-to-end encryption",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter='@notechain/web' run dev",
    "dev:marketing": "bun --filter='@notechain/marketing' run dev",
    "build": "bun run build:packages && bun run build:apps",
    "build:packages": "bun --filter='@notechain/core-crypto' --filter='@notechain/data-models' --filter='@notechain/sync-engine' --filter='@notechain/ai-engine' --filter='@notechain/ui-components' run build",
    "build:apps": "bun --filter='@notechain/web' --filter='@notechain/marketing' run build",
    "test": "bun --filter='@notechain/core-crypto' run test && bun --filter='@notechain/ai-engine' run test && bun --filter='@notechain/sync-engine' run test && bun --filter='@notechain/web' run test",
    "test:web": "bun --filter='@notechain/web' run test",
    "test:web:file": "bun --filter='@notechain/web' run test:file --",
    "smoke:meeting-to-knowledge": "bun --filter='@notechain/web' run test:smoke:meeting-to-knowledge",
    "smoke:public-beta": "bun --filter='@notechain/web' run test:smoke:public-beta",
    "verify:privacy": "bun --filter='@notechain/web' run test:verify:privacy",
    "verify:sync:web": "bun --filter='@notechain/web' run test:verify:sync",
    "verify:sync-engine": "bun --filter='@notechain/sync-engine' run test:fast",
    "verify:sync-server": "bun --filter='@notechain/sync-engine' run test:server",
    "verify:sync": "bun run verify:sync:web && bun run verify:sync-engine",
    "verify:launch": "bun run smoke:meeting-to-knowledge && bun --filter='@notechain/web' run typecheck",
    "test:ci": "bun run test --coverage",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "typecheck": "bun --filter='@notechain/*' run typecheck",
    "typecheck:apps": "bun --filter='@notechain/web' --filter='@notechain/marketing' run typecheck",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules",
    "clean:all": "bun run clean && rm -rf bun.lock",
    "prepare": "husky || true",
    "validate": "bun run format:check && bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.1.6",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bun": "latest",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.27.0",
    "globals": "^17.3.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.4.0",
    "prettier": "^3.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=22.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.95.3",
    "dotenv": "^17.3.1",
    "next": "^16.1.6"
  }
}
